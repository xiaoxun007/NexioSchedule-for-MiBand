<template>
  <div class="page">
    <stack class="page-stack">
    <div class="body-layer">
    <!-- 单层常驻结构：切日只换数据、不重建任何节点。
         Vela 3.6（小米手环 9 Pro）上重建带 scroll 的层节点会导致整屏黑且点不动，
         所以这里没有双层、没有 for 复用、没有动画，切日只更新下面这些绑定。 -->
    <scroll class="body" scroll-y="true" bounces="true" if="{{isHome}}">
      <div class="screen" onswipe="onSwipe" ontouchstart="onTouchStart">
        <div class="header-row">
          <text class="weekday">{{day.weekday}}</text>
          <text class="clock" if="{{day.isToday}}">{{day.clockText}}</text>
          <div class="today-btn" else onclick="onBackToday">
            <text class="today-btn-text">今</text>
          </div>
        </div>
        <text class="date-text">{{day.dateText}}</text>

        <div class="card" if="{{day.hasNext}}">
          <div class="row">
            <text class="blue">{{day.nextLabel}}</text>
            <text class="strong-next">{{day.nextName}}</text>
            <text class="blue">{{day.nextCountdown}}</text>
          </div>
          <text class="meta">{{day.nextMeta}}</text>
        </div>

        <block for="{{(groupIndex, group) in day.groups}}">
          <div class="tag-wrap">
            <text class="tag">{{group.label}}</text>
          </div>
          <div class="card" for="{{(courseIndex, course) in group.courses}}">
            <div class="row">
              <text class="strong">{{course.name}}</text>
              <text class="blue">{{course.timeText}}</text>
            </div>
            <div class="row">
              <text class="meta">{{course.meta}}</text>
              <text class="meta">{{course.status}}</text>
            </div>
          </div>
        </block>

        <div class="empty-wrap" if="{{day.showEmpty}}">
          <div class="empty-pill">
            <text class="empty-title">{{day.emptyTitle}}</text>
            <text class="empty-sub" if="{{day.showNeedPhone}}">{{day.emptySub}}</text>
          </div>
        </div>
      </div>
    </scroll>

    <scroll class="body" scroll-y="true" bounces="true" if="{{isAbout}}">
    <div class="screen screen-about">
      <text class="page-title">应用信息</text>

      <div class="card">
        <div class="row-app">
          <image class="app-icon" src="/common/about_icon.png"></image>
          <div class="app-text">
            <text class="app-name">nexio课程表</text>
            <text class="app-ver">版本: v1.2.0</text>
          </div>
        </div>
      </div>

      <!-- 同步诊断：手机推送是否到达、数据来源、周次与动画模式 -->
      <div class="card">
        <text class="app-ver">{{diagLine1}}</text>
        <text class="app-ver">{{diagLine2}}</text>
        <text class="app-ver">{{diagLine3}}</text>
        <text class="app-ver">{{diagLine4}}</text>
      </div>

      <text class="section-label">开发人员名单</text>

      <div class="card people-card">
        <div class="person">
          <image class="avatar" src="/common/photo1.png"></image>
          <div class="person-text">
            <text class="person-name">一個小果冻</text>
            <text class="person-role">快应用开发设计</text>
          </div>
        </div>
        <div class="person">
          <image class="avatar" src="/common/photo2.png"></image>
          <div class="person-text">
            <text class="person-name">Sunlight</text>
            <text class="person-role">nexio开发者</text>
          </div>
        </div>
      </div>

      <!-- 打赏入口：放在关于页最后 -->
      <div class="card entry-card" onclick="onOpenReward">
        <div class="entry-row">
          <text class="entry-label">打赏支持</text>
          <text class="entry-hint">扫码支持</text>
        </div>
      </div>
    </div>
    </scroll>

    <!-- ============ 打赏 ============ -->
    <scroll class="body" scroll-y="true" bounces="true" if="{{isReward}}">
      <!-- 打赏页：向右侧滑返回关于页 -->
      <div class="screen-reward" onswipe="onRewardSwipe">
        <div class="reward-head">
          <text class="reward-title">感谢打赏！</text>
          <text class="reward-title">谢谢喵！</text>
        </div>
        <div class="reward-card">
          <image class="reward-qr" src="/common/reward_qr.png"></image>
        </div>
      </div>
    </scroll>

    <div class="sys-back-edge" if="{{isHome}}"></div>
    </div>
    </stack>

    <div class="tab-bar">
      <div class="tab-btn" onclick="onTabHome">
        <div class="tab-slot">
          <div class="tab-hl tab-in-l" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
          <div class="tab-hl-off tab-in-l" show="{{aboutActive}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
        </div>
      </div>

      <div class="tab-btn" onclick="onTabAbout">
        <div class="tab-slot">
          <div class="tab-hl tab-in-r" show="{{aboutActive}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
          <div class="tab-hl-off tab-in-r" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import sync from '../../common/sync'
import schedule from '../../common/schedule'
import util from '../../common/util'
import device from '@system.device'

/** 左缘留给系统「右滑回桌面」的宽度，与 .sys-back-edge 保持一致（432 宽屏按屏宽比例放大） */
const EDGE_W = 15

export default {
  private: {
    isHome: true,
    isAbout: false,
    isReward: false,
    /* 打赏页也算「关于」这一支：底部 Tab 保持高亮 */
    aboutActive: false,
    /* 当前展示的那一天（单层常驻，切日只换这个对象） */
    day: {},
    viewDateTs: 0,
    /* 同步诊断（关于页展示） */
    diagLine1: '',
    diagLine2: '',
    diagLine3: '',
    diagLine4: ''
  },
  onInit() {
    this.unsubscribe = sync.onScheduleChange(() => {
      this.refreshHome()
      this.refreshDiagnostics()
    })
    sync.init()
    this.probePlatform()
    this.refreshHome()
    this.refreshDiagnostics()
    this._refreshTimer = setInterval(() => {
      this.refreshHome()
    }, 60000)
  },
  onShow() {
    this.refreshHome()
    this.refreshDiagnostics()
    // 数据过期就主动向手机拉一次，别等手机那边点推送
    sync.ensureFresh('show')
  },
  onDestroy() {
    if (this._refreshTimer) {
      clearInterval(this._refreshTimer)
      this._refreshTimer = null
    }
    if (this.unsubscribe) {
      this.unsubscribe()
      this.unsubscribe = null
    }
  },
  getViewDate() {
    return this.viewDateTs ? new Date(this.viewDateTs) : new Date()
  },
  /**
   * 同步诊断：手机推送有没有到达、数据来自推送还是缓存、
   * 手环自己算出的周次是多少（整表模式下与手机一致）。
   */
  refreshDiagnostics() {
    const s = sync.getStatus()
    const at = s.lastAt ? util.formatClock(new Date(s.lastAt)) : '-'
    const src =
      s.lastSource === 'phone' ? '手机推送' : s.lastSource === 'cache' ? '本地缓存' : '无数据'
    this.diagLine1 =
      '周次 ' + (schedule.weekTextFor(new Date()) || '-') + ' · ' + (s.ready ? '手机已连接' : '手机未连接')
    this.diagLine2 = '数据 ' + src + ' ' + at + ' · rev' + s.rev
    this.diagLine3 = (s.lastShape || '-') + (s.lastError ? ' · ' + s.lastError : '')
    this.diagLine4 =
      '平台 ' + (this._platform || '-') + ' · 无动画 · 滑动' + (this._swipeCount || 0) + '次'
  },
  buildDay(vm, now) {
    return {
      isToday: vm.isToday,
      weekday: vm.isToday ? '今天是' + vm.weekday : vm.weekday,
      dateText: vm.weekText ? vm.dateText + ' · ' + vm.weekText : vm.dateText,
      clockText: util.formatClock(now),
      hasNext: vm.hasNext,
      nextLabel: vm.nextCourse ? vm.nextCourse.label : '下节课',
      nextName: vm.nextCourse ? vm.nextCourse.name : '',
      nextCountdown: vm.nextCourse ? vm.nextCourse.countdown : '',
      nextMeta: vm.nextCourse ? vm.nextCourse.meta : '',
      groups: vm.groups,
      showEmpty: !vm.hasCourses,
      showNeedPhone: vm.emptyState === 'need-phone',
      emptyTitle:
        vm.emptyState === 'need-phone'
          ? '请连接手机'
          : vm.emptyState === 'holiday'
            ? vm.isToday
              ? '今日是假期，好好休息吧'
              : '当天是假期，好好休息吧'
            : vm.isToday
              ? '今日无课'
              : '当天无课',
      emptySub: '打开Nexio课程表发送数据'
    }
  },
  refreshHome() {
    const now = new Date()
    const viewDate = this.getViewDate()
    const vm = schedule.buildHomeViewModel(viewDate, util, now)
    // 单层常驻：只替换这一个对象的内容，既不改节点结构也不做动画
    this.day = this.buildDay(vm, now)
  },
  /**
   * 读平台版本（Vela）与 APILevel，仅用于关于页的「同步诊断」展示。
   * 小米手环 9 Pro 是 Vela 3.6，平台信息能帮助定位机型差异。
   */
  probePlatform() {
    this._platform = '-'
    this._platform = '-'
    try {
      device.getInfo({
        success: (info) => {
          const name = (info && (info.platformVersionName || info.osVersionName)) || ''
          this._platform = name + (info && info.APILevel != null ? ' / api' + info.APILevel : '')
          console.log('[page] platform=' + name)
          this.refreshDiagnostics()
        },
        fail: () => {
          this.refreshDiagnostics()
        }
      })
    } catch (e) {
      console.log('[page] device.getInfo fail', e)
    }
  },
  /**
   * 切日：只换数据，不重建节点、不做动画。
   * Vela 3.6（小米手环 9 Pro）上重建带 scroll 的层节点会整屏黑且点不动，
   * 因此这里彻底去掉双层与出入场动画 —— 兼容优先。
   */
  goDay(delta) {
    this._swipeCount = (this._swipeCount || 0) + 1
    this.viewDateTs = util.addDays(this.getViewDate(), delta).getTime()
    this.refreshHome()
    this.refreshDiagnostics()
  },
  onBackToday() {
    this.viewDateTs = 0
    this.refreshHome()
  },
  touchXY(t) {
    if (!t) return null
    const x = t.clientX != null ? t.clientX : t.pageX != null ? t.pageX : t.x
    const y = t.clientY != null ? t.clientY : t.pageY != null ? t.pageY : t.y
    if (x == null || y == null) return null
    return { x: x, y: y }
  },
  onTouchStart(e) {
    const t = e && e.touches && e.touches[0]
    const p = this.touchXY(t)
    // 左缘起手不切日，留给系统「右滑回桌面」
    this._touchFromEdge = !!(p && p.x <= EDGE_W)
    // 同一手势只允许触发一次切日（出入场双层都会挂 handler）
    this._gestureSwiped = false
  },
  onSwipe(e) {
    // 左缘起手的滑动交给系统返回，应用内不响应
    if (this._touchFromEdge) {
      this._touchFromEdge = false
      return
    }
    if (this._gestureSwiped) return
    this._gestureSwiped = true
    const dir = e && e.direction
    if (dir === 'left') {
      this.goDay(1)
    } else if (dir === 'right') {
      this.goDay(-1)
    }
  },
  onTabHome() {
    this.isHome = true
    this.isAbout = false
    this.isReward = false
    this.aboutActive = false
    this.refreshHome()
  },
  onTabAbout() {
    this.isHome = false
    this.isAbout = true
    this.isReward = false
    this.aboutActive = true
  },
  /** 关于页 → 打赏页 */
  onOpenReward() {
    this.isHome = false
    this.isAbout = false
    this.isReward = true
    this.aboutActive = true
  },
  /** 打赏页向右侧滑返回关于页 */
  onRewardSwipe(e) {
    if (e && e.direction === 'right') {
      this.isReward = false
      this.isAbout = true
      this.aboutActive = true
    }
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  .page-stack {
    width: 100%;
    height: 100%;
  }

  /* 固定两层：内容层在下、tab-bar 在上，避免 if/else 重建后层级颠倒 */
  .body-layer {
    width: 100%;
    height: 100%;
    flex-direction: column;
    position: relative;
  }

  /* 左缘透明条：盖住应用横滑，系统「右滑回桌面」才能生效（宽度与 EDGE_W 一致） */
  .sys-back-edge {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 15px;
    height: 100%;
    background-color: transparent;
  }

  /* 切日不再有整页滑动动画，也没有双层与裁切舞台（Vela 3.6 上重建 scroll 层会黑屏）。
     现在只有一个常驻的 .body(滚动容器) + .screen(内容)，切日只更新数据绑定。 */

  .body {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
  }

  .screen {
    width: 100%;
    flex-direction: column;
    padding-top: 30px;
    padding-right: 13px;
    padding-bottom: 118px;
    padding-left: 13px;
    /* 保证可滚动/回弹：内容不足一屏时也有滚动高度（514 屏 = 屏高 + 40） */
    min-height: 554px;
  }

  /* 标题区约 122px，height=270 使文案中心落在屏幕垂直中线（514/2=257）附近 */
  .empty-wrap {
    width: 100%;
    height: 270px;
    justify-content: center;
    align-items: center;
  }

  .empty-pill {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #242424;
    border-radius: 22px;
    padding-top: 15px;
    padding-right: 31px;
    padding-bottom: 15px;
    padding-left: 31px;
  }

  .empty-title {
    font-size: 24px;
    font-weight: bold;
    color: #d1d1d6;
    text-align: center;
  }

  .empty-sub {
    font-size: 17px;
    font-weight: bold;
    color: #8e8e93;
    text-align: center;
    margin-top: 6px;
    lines: -1;
  }

  .header-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    overflow: visible;
  }

  .weekday {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 36px;
    font-weight: bold;
    color: #ffffff;
    lines: 1;
  }

  .clock {
    width: 113px;
    height: 41px;
    flex-shrink: 0;
    font-size: 31px;
    font-weight: bold;
    color: #ffffff;
    margin-left: 8px;
    text-align: right;
    lines: 1;
  }

  /* 与时间同宽，避免右上角错位 */
  .today-btn {
    width: 113px;
    height: 41px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: #242424;
    border-radius: 36px;
    margin-left: 8px;
  }

  .today-btn-text {
    font-size: 24px;
    font-weight: bold;
    color: #3381FF;
    text-align: center;
    lines: 1;
  }

  .date-text {
    width: 100%;
    font-size: 36px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 17px;
    lines: 1;
  }

  .card {
    width: 100%;
    flex-direction: column;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    background-color: #242424;
    border-radius: 19px;
    margin-bottom: 13px;
    overflow: visible;
  }

  .row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 0;
    overflow: visible;
  }

  /* 「下节课」+ 课名紧挨左侧，倒计时由 .row 的 space-between 顶到最右 */
  .row-left {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 1;
  }

  /* 下节课课名：中间弹性区，长课名折行；min-width 防止被挤成竖排 */
  .strong-next {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 123px;
    lines: -1;
    font-size: 26px;
    font-weight: bold;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 5px;
    color: #ffffff;
    overflow: visible;
  }

  /* 列表课名 */
  .strong {
    font-size: 26px;
    font-weight: bold;
    width: 100%;
    margin-left: 3px;
    margin-right: 6px;
    margin-bottom: 5px;
    color: #ffffff;
  }

  .blue {
    font-size: 22px;
    font-weight: bold;
    flex-shrink: 0;
    margin-bottom: 5px;
    color: #3381FF;
  }

  .meta {
    font-size: 20px;
    font-weight: bold;
    color: #8e8e93;
    lines: -1;
  }

  .tag-wrap {
    width: 100%;
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 10px;
  }

  .tag {
    font-size: 18px;
    font-weight: bold;
    color: #d1d1d6;
    background-color: #242424;
    border-radius: 10px;
    padding-top: 4px;
    padding-right: 13px;
    padding-bottom: 4px;
    padding-left: 13px;
  }

  /* 仅增加可滚高度以触发回弹，不改变关于页内部布局（514 屏 = 屏高 + 140） */
  .screen-about {
    min-height: 654px;
  }

  .page-title {
    width: 100%;
    font-size: 38px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 15px;
  }

  .row-app {
    width: 100%;
    flex-direction: row;
  }

  .app-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    margin-right: 15px;
  }

  .app-text {
    flex-direction: column;
  }

  .app-name {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .app-ver {
    font-size: 17px;
    font-weight: bold;
    color: #8e8e93;
  }

  .section-label {
    width: 100%;
    font-size: 17px;
    font-weight: bold;
    color: #8e8e93;
    margin-top: 6px;
    margin-bottom: 9px;
  }

  .person {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
  }

  /* 人员卡：行距作底部留白，避免双倍 */
  .people-card {
    padding-top: 15px;
    padding-bottom: 0px;
  }

  /* 图已预裁圆形透明边，勿再用 border-radius 二次硬裁 */
  .avatar {
    width: 52px;
    height: 52px;
    background-color: transparent;
    margin-right: 15px;
  }

  .person-text {
    flex: 1;
    flex-direction: column;
    align-items: flex-end;
  }

  .person-name {
    width: 100%;
    text-align: left;
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
    margin-left: 6px;
  }

  .person-role {
    width: 100%;
    text-align: left;
    font-size: 17px;
    font-weight: bold;
    color: #8e8e93;
    margin-left: 6px;
  }

  /* 悬浮 Tab：原样紧凑胶囊，按新屏宽/屏高等比重推，不横向拉伸 */
  .tab-bar {
    position: absolute;
    left: 122px;
    right: 122px;
    bottom: 32px;
    height: 70px;
    flex-direction: row;
    background-color: #282828;
    border-radius: 48px;
    align-items: center;
    overflow: visible;
    box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.18);
  }

  .tab-btn {
    width: 50%;
    height: 70px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 固定插槽，避免选中态被压成圆点 */
  .tab-slot {
    width: 84px;
    height: 59px;
    margin-top: -1px;
    overflow: visible;
  }

  /* 选中：比外框小一圈的嵌套胶囊 */
  .tab-hl {
    width: 84px;
    height: 59px;
    min-width: 84px;
    min-height: 59px;
    position: absolute;
    left: 0px;
    top: 0px;
    border-radius: 48px;
    background-color: #353535;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 未选中：同尺寸透明占位，避免图标跳动 */
  .tab-hl-off {
    width: 84px;
    height: 59px;
    min-width: 84px;
    min-height: 59px;
    position: absolute;
    left: 0px;
    top: 0px;
    border-radius: 48px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 选中框+图标向内收：覆盖 left，左往右、右往左 */
  .tab-in-l {
    left: 3px;
  }

  .tab-in-r {
    left: -3px;
  }

  .tab-icon {
